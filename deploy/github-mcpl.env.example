# The environment the launcher (deploy/github-mcpl) loads. Copy to
# ~/.config/github-mcpl/github-mcpl.env, mode 600, owned by the agent's user.
# It is sourced by sh, so $HOME expands.
#
# NO SECRET BELONGS IN THIS FILE. The App private key and the webhook secret
# are read from the files named below, which are mode 600: a value here would
# land in the environment of the server and of every process it starts.
#
# Every variable is documented in README.md ("Set the environment"); readConfig
# in src/types.ts is what validates them.

# --- runtime ----------------------------------------------------------------
# The absolute path of Node 22.12.0 or newer. README step 7 appends it with
# `command -v node`, because a host started by systemd does not see nvm's PATH.
#GITHUB_MCPL_NODE=

# --- identity -------------------------------------------------------------
GITHUB_APP_ID=REPLACE_WITH_NUMERIC_APP_ID
GITHUB_APP_PRIVATE_KEY_FILE=$HOME/.config/github-mcpl/app-private-key.pem
# Optional: discovered from GITHUB_REPOS when absent.
#GITHUB_APP_INSTALLATION_ID=
GITHUB_BOT_LOGIN=REPLACE_WITH_APP_SLUG[bot]

# --- scope ----------------------------------------------------------------
# Comma-separated; several repositories must share one owner.
GITHUB_REPOS=REPLACE_WITH_OWNER/REPLACE_WITH_REPO
# `branch` for every repository, `owner/name:branch` for one of them.
# e.g. a repository that merges into dev; the contributor recipe's targets use main.
GITHUB_PR_BASE_ALLOW=dev
GITHUB_MAINTAINERS=REPLACE_WITH_MAINTAINER_LOGIN

# --- ingress: ONE of the two ----------------------------------------------
# The webhook and the poller dedup on different keys, so with both on the
# same comment reaches the agent twice. Pick one; see docs/deploy.md.
#
# Webhook (recommended): a submitted review and a review request arrive by no
# other route. Leave the port unset to turn the listener off.
GITHUB_WEBHOOK_SECRET_FILE=$HOME/.config/github-mcpl/webhook-secret
GITHUB_WEBHOOK_PORT=9042
GITHUB_WEBHOOK_PATH=/github/webhook

# Polling (fallback, partial): 0 is off, and a non-zero value below 60000 is
# refused at startup. Set this only with GITHUB_WEBHOOK_PORT unset, and
# uncheck "Active" on the App's webhook while it runs.
GITHUB_POLL_INTERVAL_MS=0

# --- state ----------------------------------------------------------------
GITHUB_STATE_FILE=$HOME/.config/github-mcpl/state.json
