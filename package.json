{
  "name": "@connectome/github-mcpl",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "github-mcpl": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-isolation=none test/*.test.ts",
    "start": "node --import tsx src/index.ts",
    "clean": "rm -rf dist",
    "version": "node scripts/release-changelog.mjs && git add CHANGELOG.md changelog.d"
  },
  "dependencies": {
    "@animalabs/mcpl-core": "^0.4.0",
    "octokit": "^4.1.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
